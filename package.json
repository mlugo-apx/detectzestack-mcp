{
  "name": "detectzestack-mcp",
  "version": "1.0.0",
  "description": "MCP server for DetectZeStack — detect tech stacks, security headers, SSL certificates, DNS records, and vulnerabilities for any website",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "detectzestack-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "detectzestack",
    "tech-stack",
    "technology-detection",
    "security-headers",
    "ssl-certificate",
    "dns-lookup",
    "vulnerability-scanner",
    "wappalyzer",
    "builtwith"
  ],
  "author": "DetectZeStack <info@detectzestack.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlugo-apx/detectzestack-mcp.git"
  },
  "homepage": "https://detectzestack.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
